FROM node:22-alpine AS builder
WORKDIR /app

# Arquivos de configuração do workspace
COPY package.json package-lock.json turbo.json ./

# package.json de cada workspace necessário
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/web/package.json ./apps/web/

# Instala todas as dependências
RUN npm ci

# Copia o código fonte
COPY packages/shared-types ./packages/shared-types
COPY apps/web ./apps/web

# NEXT_PUBLIC_API_URL é injetada em build time pelo Next.js
ENV NEXT_PUBLIC_API_URL=https://api.simtc.com.br/api

# Build: turbo compila shared-types primeiro, depois o web
RUN npx turbo run build --filter=@simtc/web...

# ---- Imagem de produção ----
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# standalone output já inclui as dependências necessárias rastreadas pelo Next.js
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
