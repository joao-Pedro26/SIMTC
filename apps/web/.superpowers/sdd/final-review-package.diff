@@ -0,0 +1,67 @@
+'use client'
+
+import { useState } from 'react'
+import { InfoTab } from './info-tab'
+import { ParticipantsTab } from './participants-tab'
+import { QrCodeTab } from './qr-code-tab'
+import { DocumentsTab } from './documents-tab'
+import type { TrainingSession } from './types'
+import styles from './training-session-detail-tabs.module.css'
+
+type Tab = 'info' | 'participants' | 'qrcode' | 'documents'
+
+interface TrainingSessionDetailTabsProps {
+  session: TrainingSession
+  onUpdateSession: (updated: TrainingSession) => void
+}
+
+const tabs: { id: Tab; label: string }[] = [
+  { id: 'info', label: 'Informações' },
+  { id: 'participants', label: 'Participantes' },
+  { id: 'qrcode', label: 'QR Code' },
+  { id: 'documents', label: 'Documentos' },
+]
+
+export function TrainingSessionDetailTabs({ session, onUpdateSession }: TrainingSessionDetailTabsProps) {
+  const [activeTab, setActiveTab] = useState<Tab>('info')
+
+  function handleArchive() {
+    onUpdateSession({ ...session, status: 'ARQUIVADO' })
+  }
+
+  function handleCancel() {
+    onUpdateSession({ ...session, status: 'CANCELADO' })
+  }
+
+  return (
+    <div className={styles.wrapper}>
+      <div className={styles.tabList} role="tablist">
+        {tabs.map((tab) => (
+          <button
+            key={tab.id}
+            role="tab"
+            aria-selected={activeTab === tab.id}
+            className={`${styles.tab} ${activeTab === tab.id ? styles.tabActive : ''}`}
+            onClick={() => setActiveTab(tab.id)}
+          >
+            {tab.label}
+          </button>
+        ))}
+      </div>
+      <div className={styles.panel}>
+        {activeTab === 'info' && (
+          <InfoTab session={session} onArchive={handleArchive} onCancel={handleCancel} />
+        )}
+        {activeTab === 'participants' && (
+          <ParticipantsTab session={session} onUpdateSession={onUpdateSession} />
+        )}
+        {activeTab === 'qrcode' && (
+          <QrCodeTab session={session} />
+        )}
+        {activeTab === 'documents' && (
+          <DocumentsTab session={session} />
+        )}
+      </div>
+    </div>
+  )
+}
