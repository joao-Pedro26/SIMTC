+import { QrCode, ArrowLeft } from 'lucide-react'
+import Link from 'next/link'
+import { mockTrainingSessions } from '@/features/training-sessions/mock-data'
+import styles from './page.module.css'
+
+interface QRCodePageProps {
+  params: { id: string }
+}
+
+export default function QRCodeProjectionPage({ params }: QRCodePageProps) {
+  const session = mockTrainingSessions.find((s) => s.id === Number(params.id))
+
+  if (!session) {
+    return (
+      <div className={styles.notFound}>
+        <p>Treinamento não encontrado.</p>
+        <Link href="/training-sessions" className={styles.backLink}>
+          ← Voltar para treinamentos
+        </Link>
+      </div>
+    )
+  }
+
+  const publicUrl = `simtc.com.br/register/${session.qrCodeToken}`
+
+  return (
+    <div className={styles.page}>
+
+      <div className={styles.topBar}>
+        <Link href="/training-sessions" className={styles.backBtn}>
+          <ArrowLeft size={16} /> Voltar
+        </Link>
+        <div className={styles.sessionInfo}>
+          <span className={styles.companyName}>{session.company.name}</span>
+          <span className={styles.separator}>·</span>
+          <span className={styles.courseName}>{session.course.name}</span>
+        </div>
+      </div>
+
+      <div className={styles.center}>
+        <div className={styles.qrBox}>
+          <QrCode size={280} strokeWidth={0.75} className={styles.qrIcon} />
+        </div>
+        <p className={styles.url}>{publicUrl}</p>
+        <p className={styles.instruction}>
+          Aponte a câmera do celular para o QR Code acima para se cadastrar no treinamento.
+        </p>
+      </div>
+
+    </div>
+  )
+}
